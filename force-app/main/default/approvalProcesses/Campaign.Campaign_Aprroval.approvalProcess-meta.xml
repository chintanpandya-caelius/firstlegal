<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>false</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Owner</field>
        <field>Approval_Status__c</field>
        <field>Content_Summary__c</field>
        <field>Planned_Send_Date__c</field>
        <field>Audience_Size__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <name>salesoperation_testuser@firstlegal.com</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <label>Marketing Ops Approval</label>
        <name>Marketing_Ops_Approval</name>
    </approvalStep>
    <emailTemplate>unfiled$public/Campaign_Approval_Request</emailTemplate>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <criteriaItems>
            <field>Campaign.Approval_Status__c</field>
            <operation>equals</operation>
            <value>Submitted for Approval</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>ApprovalStatus_to_Approved</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Approver</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>CampaignStatustoAppr</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Last_Approved_on</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Notify_Campaign_Owner_Approvd</name>
            <type>Alert</type>
        </action>
        <action>
            <name>SetRequiresReapprovaltoFalse</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>NotifyCampaignOwner_Rejected</name>
            <type>Alert</type>
        </action>
        <action>
            <name>SetRequiresReapprovaltoTrue</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>SetStatustoRejected</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Notify_Approver</name>
            <type>Alert</type>
        </action>
        <action>
            <name>Pending_for_Approval</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>Campaign Aprroval</label>
    <processOrder>1</processOrder>
    <recordEditability>AdminOnly</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
