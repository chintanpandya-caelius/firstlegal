    </decisions>
    <description>Scheduled nightly flow that evaluates ABM Target Accounts and calculates Influence Coverage Summary counts (High Influence, Champion/Coach, Medium Influence, Low/No Influence, Unknown Influence) by looping through related Account Contact Relationship records and their Contact Influence Role values. Also sets Influence Mapping Gap to true when no High Influence or Champion/Coach contacts are identified, flagging the Account for outreach planning. Part of NOVA — Track Contact Influence for ABM Targeting.</description>
    <environments>Default</environments>
    <formulas>
        <name>formulaInfluenceMappingGap</name>
        <dataType>Boolean</dataType>
        <expression>IF(({!countHighInfluence} + {!countChampionCoach}) = 0, true, false)</expression>
    </formulas>
    <formulas>
        <name>formulaSuggestedMappingStatus</name>
        <dataType>String</dataType>
        <expression>IF(
  ISBLANK(TEXT({!$Record.Influence_Mapping_Status__c})) || TEXT({!$Record.Influence_Mapping_Status__c}) = &quot;Not Started&quot;,
  IF({!formulaInfluenceMappingGap}, &quot;Gap Identified&quot;, &quot;In Progress&quot;),
  TEXT({!$Record.Influence_Mapping_Status__c})
)</expression>
    </formulas>
    <interviewLabel>ABM Account Nightly Influence Coverage Update {!$Flow.CurrentDateTime}</interviewLabel>
    <label>ABM Account Nightly Influence Coverage Update</label>
    <loops>
        <name>Loop_Through_Contact_Relations</name>
        <label>Loop Through Contact Relations</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Related_Contact_Relations</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Check_Influence_Role</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Update_Influence_Coverage_Counts</targetReference>
        </noMoreValuesConnector>
    </loops>
