<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Set_Inactivity_Values</name>
        <label>Set Inactivity Values</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Days_Since_Last_Activity__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>DaysInactive</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Determine_Inactivity_Level</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Determine_Inactivity_Level</name>
        <label>Determine Inactivity Level</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Update_Active_Records</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Active</defaultConnectorLabel>
        <rules>
            <name>Active</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>DaysInactive</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>60.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_High_Risk_Records</targetReference>
            </connector>
            <label>High Risk</label>
        </rules>
        <rules>
            <name>Medium</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>DaysInactive</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>30.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>DaysInactive</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <numberValue>60.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Medium_Risk_Records</targetReference>
            </connector>
            <label>Medium</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>DaysInactive</name>
        <dataType>Number</dataType>
        <expression>TODAY() - DATEVALUE($Record.LastModifiedDate)</expression>
        <scale>0</scale>
    </formulas>
    <interviewLabel>Contact - Inactivity Status Update {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Contact - Inactivity Status Update</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Update_Active_Records</name>
        <label>Update Active Records.</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Days_Since_Last_Activity__c</field>
            <value>
                <elementReference>DaysInactive</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Inactive_Flag__c</field>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Inactivity_Level__c</field>
            <value>
                <stringValue>Active</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Update_High_Risk_Records</name>
        <label>Update High Risk Records.</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Days_Since_Last_Activity__c</field>
            <value>
                <elementReference>DaysInactive</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Inactive_Flag__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Inactivity_Level__c</field>
            <value>
                <stringValue>High Risk</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Medium_Risk_Records</name>
        <label>Update Medium Risk Records.</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Days_Since_Last_Activity__c</field>
            <value>
                <elementReference>DaysInactive</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Inactive_Flag__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Inactivity_Level__c</field>
            <value>
                <stringValue>Medium Risk</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Set_Inactivity_Values</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>IsDeleted</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Contact</object>
        <schedule>
            <dayOfMonthToRun>0</dayOfMonthToRun>
            <frequency>Daily</frequency>
            <frequencyNumber>0</frequencyNumber>
            <startDate>2026-07-08</startDate>
            <startTime>21:30:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Active</status>
</Flow>
