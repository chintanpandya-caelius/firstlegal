    <formulas>
        <name>Formula_Contact_Full_Name</name>
        <dataType>String</dataType>
        <expression>TRIM({!$Record.FirstName} &amp; &quot; &quot; &amp; {!$Record.LastName})</expression>
    </formulas>
    <formulas>
        <name>Formula_Handoff_SLA_Due_Date</name>
        <dataType>Date</dataType>
        <expression>     NOW() + CASE(WEEKDAY(DATEVALUE(NOW())), 6, 3, 7, 2, 1)</expression>
    </formulas>
    <formulas>
        <name>Formula_Handoff_SLA_DueDateTime</name>
        <dataType>DateTime</dataType>
        <expression>     NOW() + CASE(WEEKDAY(DATEVALUE(NOW())), 6, 3, 7, 2, 1)</expression>
    </formulas>
    <formulas>
        <name>Formula_Handoff_Status</name>
        <dataType>String</dataType>
        <expression>IF(TEXT({!$Record.Handoff_Trigger__c}) = &quot;Direct Inquiry&quot;, &quot;Fast-Track&quot;, &quot;Handoff Ready&quot;)</expression>
    </formulas>
    <formulas>
        <name>TT_Handoff_Notification_Body</name>
        <dataType>String</dataType>
        <expression>{!Get_Contact_Account.Name} &amp; &quot; - Trigger: &quot; &amp; TEXT({!$Record.Handoff_Trigger__c}) &amp; &quot;. Priority Score: &quot; &amp; TEXT({!varPriorityScore}) &amp; &quot;. Follow up by &quot; &amp; TEXT({!Formula_Handoff_SLA_Due_Date}) &amp; &quot;.&quot;</expression>
    </formulas>
    <formulas>
        <name>TT_Handoff_Notification_Title</name>
        <dataType>String</dataType>
        <expression>&quot;Sales Handoff: &quot; &amp; {!Formula_Contact_Full_Name}</expression>
    </formulas>
