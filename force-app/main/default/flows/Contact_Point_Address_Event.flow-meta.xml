<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <constants>
        <name>ContactPointAddress</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Contact Point Address</stringValue>
        </value>
    </constants>
    <constants>
        <name>CustomerRecordType</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Customer</stringValue>
        </value>
    </constants>
    <decisions>
        <name>Account_In_Scope</name>
        <label>Account In Scope</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>In_Scope</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Parent_Account.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Parent_Account.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>CustomerRecordType</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Parent_Account.Status__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>New</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Parent_Account.accountID__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Publish_Address_Event</targetReference>
            </connector>
            <label>In Scope</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>varChangeType</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!$Record__Prior.Id}), &quot;Create&quot;, &quot;Update&quot;)</expression>
    </formulas>
    <interviewLabel>Contact Point Address Event {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Contact Point Address Event</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Parent_Account</name>
        <label>Get Parent Account</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Account_In_Scope</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.ParentId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Account</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Parent_Account</targetReference>
        </connector>
        <filterFormula>NOT(ISCHANGED({!$Record.Latest_Sync_Denial_Timestamp__c}))</filterFormula>
        <object>ContactPointAddress</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <subflows>
        <name>Publish_Address_Event</name>
        <label>Publish Address Event</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <flowName>Publish_Account_Data_Change</flowName>
        <inputAssignments>
            <name>inChangeActualId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>inChangedObject</name>
            <value>
                <elementReference>ContactPointAddress</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>inChangeParentId</name>
            <value>
                <elementReference>Get_Parent_Account.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>inChangeType</name>
            <value>
                <elementReference>varChangeType</elementReference>
            </value>
        </inputAssignments>
    </subflows>
</Flow>
