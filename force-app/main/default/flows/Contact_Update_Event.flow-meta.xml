<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Add_To_Collection</name>
        <label>Add To Collection</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>colEvents</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>varEvent</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>For_Each_Junction</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Build_Event</name>
        <label>Build Event</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varEvent.ChangedObject__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>ContactObject</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varEvent.ChangeType__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>UpdateEvent</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varEvent.ChangeParentId__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>For_Each_Junction.AccountId</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varEvent.ChangeActualId__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varEvent.ChangeTimestamp__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Add_To_Collection</targetReference>
        </connector>
    </assignments>
    <constants>
        <name>ContactObject</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Contact</stringValue>
        </value>
    </constants>
    <constants>
        <name>CustomerRecordType</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Customer</stringValue>
        </value>
    </constants>
    <constants>
        <name>UpdateEvent</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Update</stringValue>
        </value>
    </constants>
    <decisions>
        <name>Account_Qualifies</name>
        <label>Account Qualifies</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>For_Each_Junction</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Skip</defaultConnectorLabel>
        <rules>
            <name>Qualifies</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>For_Each_Junction.Account.RecordTypeId</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Get_Customer_Record_Type.Id</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>For_Each_Junction.Account.Status__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>New</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>For_Each_Junction.Account.accountID__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Build_Event</targetReference>
            </connector>
            <label>Qualifies</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>Contact Update Event {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Contact Update Event</label>
    <loops>
        <name>For_Each_Junction</name>
        <label>For Each Junction</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Junctions</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Account_Qualifies</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Publish_Contact_Update_Events</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Publish_Contact_Update_Events</name>
        <label>Publish Contact Update Events</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputReference>colEvents</inputReference>
    </recordCreates>
    <recordLookups>
        <name>Get_Customer_Record_Type</name>
        <label>Get Customer Record Type</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Junctions</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>SobjectType</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Account</stringValue>
            </value>
        </filters>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>CustomerRecordType</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>RecordType</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Junctions</name>
        <label>Get Junctions</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>For_Each_Junction</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>ContactId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>AccountContactRelation</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Customer_Record_Type</targetReference>
        </connector>
        <filterFormula>AND(
  NOT(ISCHANGED({!$Record.Latest_Sync_Denial_Timestamp__c})),
  NOT(ISPICKVAL({!$Record.Status__c}, &quot;New&quot;)),
  NOT(AND(ISCHANGED({!$Record.Status__c}),
          ISPICKVAL(PRIORVALUE({!$Record.Status__c}), &quot;New&quot;)))
)</filterFormula>
        <object>Contact</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>colEvents</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Account_Data_Change__e</objectType>
    </variables>
    <variables>
        <name>varEvent</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Account_Data_Change__e</objectType>
    </variables>
</Flow>
