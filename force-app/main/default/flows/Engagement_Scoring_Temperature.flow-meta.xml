<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>For_Click</name>
        <label>For Click</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Lead_Score__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Add_10_To_Score</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Check_Temperature</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>For_Email_Open</name>
        <label>For Email Open</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Lead_Score__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Add_5_To_Score</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Check_Temperature</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Temperature_Cold</name>
        <label>Set Temperature Cold</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Lead_Temperature__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Cold</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Set_Temperature_Hot</name>
        <label>Set Temperature Hot</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Lead_Temperature__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Hot</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Get_Sales_Queue</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Temperature_Warm</name>
        <label>Set Temperature Warm</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Lead_Temperature__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Warm</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Add_Lead_to_Nurture_Campaign</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Check_Temperature</name>
        <label>Check Temperature</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Set_Temperature_Cold</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>HOT</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Lead_Score__c</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>50.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Temperature_Hot</targetReference>
            </connector>
            <label>HOT</label>
        </rules>
        <rules>
            <name>WARM</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Lead_Score__c</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>20.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Lead_Score__c</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>50.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Temperature_Warm</targetReference>
            </connector>
            <label>WARM</label>
        </rules>
    </decisions>
    <decisions>
        <name>CheckEngagementType</name>
        <label>Check Engagement Type</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Check_Temperature</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>EmailOpened</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Email_Opened__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>For_Email_Open</targetReference>
            </connector>
            <label>Email Opened</label>
        </rules>
        <rules>
            <name>Link_Clicked</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Link_Clicked__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>For_Click</targetReference>
            </connector>
            <label>Link Clicked</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>Add_10_To_Score</name>
        <dataType>Number</dataType>
        <expression>{!$Record.Lead_Score__c}+10</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>Add_5_To_Score</name>
        <dataType>Number</dataType>
        <expression>{!$Record.Lead_Score__c} 
+ 5</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>Engagement Scoring &amp; Temperature {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Engagement Scoring &amp; Temperature</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
