        <object>CampaignMember</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordCreates>
        <name>Create_Follow_Up_Task_for_Hot_Lead</name>
        <label>Create Follow-Up Task for Hot Lead</label>
