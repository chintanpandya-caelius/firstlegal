<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Check_Condition_U</name>
        <label>Check Condition</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Check_Status</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Redaction_Requested</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Redactions_Requested__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Redactions_Requested__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Task_U</targetReference>
            </connector>
            <label>Redaction Requested</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Operation_Type</name>
        <label>Check Operation Type</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Send_To_MuleSoft</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>UPDATE</defaultConnectorLabel>
        <rules>
            <name>INSERT</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>f_B_IsNew</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <label>INSERT</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Status</name>
        <label>Check Status</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>First_Look_Sent_Review_Pending</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>First Look Sent - Review Pending</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Email_First_Look_Sent_Review_Pending</targetReference>
            </connector>
            <label>First Look Sent – Review Pending</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Status_X1</name>
        <label>Check Status</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>First_Look_Sent_Review_Pending_X1</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>First Look Sent - Review Pending</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Copy_2_of_Send_Email</targetReference>
            </connector>
            <label>First Look Sent – Review Pending</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>f_B_IsNew</name>
        <dataType>Boolean</dataType>
        <expression>IsNew()</expression>
    </formulas>
    <formulas>
        <name>F_D_TaskDueDate</name>
        <dataType>Date</dataType>
        <expression>DateValue({!$Record.Redaction_Request_DateTime__c}) + 5</expression>
    </formulas>
    <interviewLabel>FL - First Look Review - After Trigger {!$Flow.CurrentDateTime}</interviewLabel>
    <label>FL - First Look Review - After Trigger</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Task_U</name>
        <label>Create Task</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_Status</targetReference>
        </connector>
        <inputAssignments>
            <field>ActivityDate</field>
            <value>
                <elementReference>F_D_TaskDueDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Open</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <stringValue>Review Privilege Log</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>TaskSubtype</field>
            <value>
                <stringValue>Task</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhatId</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <object>Task</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_Operation_Type</targetReference>
        </connector>
        <filterFormula>NOT({!$Setup.Global_Mute_Config__c.Mute_Trigger__c})</filterFormula>
        <object>First_Look_Review__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <scheduledPaths>
            <name>X1_Day_Before_Review_DeadLine</name>
            <connector>
                <targetReference>Send_Email_First_Look_Sent_Review_Pending_Reminer</targetReference>
            </connector>
            <label>1 Day Before Review DeadLine</label>
            <offsetNumber>-1</offsetNumber>
            <offsetUnit>Days</offsetUnit>
            <recordField>Review_Redaction_Deadline__c</recordField>
            <timeSource>RecordField</timeSource>
        </scheduledPaths>
        <scheduledPaths>
            <name>X1_Day_After_Review_DeadLine</name>
            <connector>
                <targetReference>Check_Status_X1</targetReference>
            </connector>
            <label>1 Day After Review DeadLine</label>
            <offsetNumber>1</offsetNumber>
            <offsetUnit>Days</offsetUnit>
            <recordField>Reminder_Sent_DateTime__c</recordField>
            <timeSource>RecordField</timeSource>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <subflows>
        <name>Copy_2_of_Send_Email</name>
        <label>Send Email First Look Sent – Review Pending Escalation</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <flowName>FL_Email_Notification</flowName>
        <inputAssignments>
            <name>EmailTemplateName</name>
            <value>
                <stringValue>First Look Sent – Review Pending Escalation</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>firstLookReview</name>
            <value>
                <elementReference>$Record</elementReference>
            </value>
        </inputAssignments>
    </subflows>
    <subflows>
        <name>Send_Email_First_Look_Sent_Review_Pending</name>
        <label>Send Email First Look Sent – Review Pending</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <flowName>FL_Email_Notification</flowName>
        <inputAssignments>
            <name>EmailTemplateName</name>
            <value>
                <stringValue>First Look Sent – Review Pending</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>firstLookReview</name>
            <value>
                <elementReference>$Record</elementReference>
            </value>
        </inputAssignments>
    </subflows>
    <subflows>
        <name>Send_Email_First_Look_Sent_Review_Pending_Reminer</name>
        <label>Send Email First Look Sent – Review Pending Reminer</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <flowName>FL_Email_Notification</flowName>
        <inputAssignments>
            <name>EmailTemplateName</name>
            <value>
                <stringValue>First Look Sent – Review Pending Reminder</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>firstLookReview</name>
            <value>
                <elementReference>$Record</elementReference>
            </value>
        </inputAssignments>
    </subflows>
    <subflows>
        <name>Send_To_MuleSoft</name>
        <label>Send To MuleSoft</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_Condition_U</targetReference>
        </connector>
        <flowName>FL_MuleSoft_Integration</flowName>
        <inputAssignments>
            <name>First_Look_Review</name>
            <value>
                <elementReference>$Record</elementReference>
            </value>
        </inputAssignments>
    </subflows>
</Flow>
