<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <description>Generates one time password for customer verification</description>
        <name>Generate_One_Time_Password</name>
        <label>Generate One Time Password</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>generateVerificationCode</actionName>
        <actionType>generateVerificationCode</actionType>
        <connector>
            <targetReference>Send_Email_to_the_User</targetReference>
        </connector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <nameSegment>generateVerificationCode</nameSegment>
        <offset>0</offset>
        <outputParameters>
            <assignToReference>oneTimePassword</assignToReference>
            <name>verificationCode</name>
        </outputParameters>
        <outputParameters>
            <assignToReference>AuthenticationKey</assignToReference>
            <name>authenticationKey</name>
        </outputParameters>
    </actionCalls>
    <actionCalls>
        <name>Send_Email_to_the_User</name>
        <label>Send Email to the User</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>emailSimple</actionName>
        <actionType>emailSimple</actionType>
        <connector>
            <targetReference>Output_Message_Assignment</targetReference>
        </connector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>recipientAddresses</name>
            <value>
                <collectionElements>
                    <elementReference>customer_email</elementReference>
                </collectionElements>
            </value>
        </inputParameters>
        <inputParameters>
            <name>senderType</name>
            <value>
                <inputConfiguratorMode>Custom</inputConfiguratorMode>
                <stringValue>OrgWideEmailAddress</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>senderAddress</name>
            <value>
                <inputConfiguratorMode>Custom</inputConfiguratorMode>
                <stringValue>qa_service@firstlegal.com</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>composeEmailContent</name>
            <value>
                <stringValue>True</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailSubject</name>
            <value>
                <inputConfiguratorMode>Resource</inputConfiguratorMode>
                <stringValue>FirstLegal | Here is your OTP</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailBody</name>
            <value>
                <inputConfiguratorMode>Custom</inputConfiguratorMode>
                <stringValue>&lt;p&gt;Hey User,&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Here is your One Time Password: {!oneTimePassword}&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Please use this to authrnticate yourself with our chatbot.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Regards,&lt;/p&gt;&lt;p&gt;FirstLegal&lt;/p&gt;</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>sendRichBody</name>
            <value>
                <booleanValue>true</booleanValue>
                <inputConfiguratorMode>Resource</inputConfiguratorMode>
            </value>
        </inputParameters>
        <inputParameters>
            <name>useLineBreaks</name>
            <value>
                <booleanValue>true</booleanValue>
                <inputConfiguratorMode>Resource</inputConfiguratorMode>
            </value>
        </inputParameters>
        <nameSegment>emailSimple</nameSegment>
        <offset>0</offset>
        <versionString>3.0.1</versionString>
    </actionCalls>
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>To set the output message to be sent to agentforce</description>
        <name>Copy_1_of_Output_Message_Assignment</name>
        <label>Output Message Assignment</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>messageToAgentforce</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Sorry this email address could not be associated with any registered users, please consider creating an account with FirstLegal and try again.</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <description>To set the output message to be sent to agentforce</description>
        <name>Output_Message_Assignment</name>
        <label>Output Message Assignment</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>messageToAgentforce</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>An email has been sent to this Email ID please provide the OTP to complete verification</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <description>To check if the portal user is an existing user</description>
        <name>Is_Existing_User</name>
        <label>Is Existing User</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Copy_1_of_Output_Message_Assignment</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>NOT Existing User</defaultConnectorLabel>
        <rules>
            <name>Existing_User</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_the_user_context</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Generate_One_Time_Password</targetReference>
            </connector>
            <label>Existing User</label>
        </rules>
    </decisions>
    <description>Send One Time Password to the email provided by the user</description>
    <environments>Default</environments>
    <interviewLabel>Flow: Send One Time Password {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Flow: Send One Time Password</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
