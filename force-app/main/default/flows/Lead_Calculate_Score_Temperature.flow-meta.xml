    </formulas>
    <formulas>
        <name>DefaultContactRole</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK(TEXT({!$Record.Contact_Role__c})), &quot;Administrator&quot;, TEXT({!$Record.Contact_Role__c}))</expression>
    </formulas>
    <formulas>
        <name>DefaultIndustry</name>
