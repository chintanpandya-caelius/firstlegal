    <formulas>
        <name>Formula_S3_DueDate</name>
        <dataType>DateTime</dataType>
        <expression>DATETIMEVALUE(
TEXT(YEAR({!$Flow.CurrentDate} + CASE(WEEKDAY({!$Flow.CurrentDate}), 6, 3, 7, 2, 1))) + &quot;-&quot; +
TEXT(MONTH({!$Flow.CurrentDate} + CASE(WEEKDAY({!$Flow.CurrentDate}), 6, 3, 7, 2, 1))) + &quot;-&quot; +
TEXT(DAY({!$Flow.CurrentDate} + CASE(WEEKDAY({!$Flow.CurrentDate}), 6, 3, 7, 2, 1))) + &quot; 17:00:00&quot;
)</expression>
    </formulas>
    <formulas>
