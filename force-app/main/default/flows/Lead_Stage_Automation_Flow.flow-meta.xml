        <dataType>DateTime</dataType>
        <expression>DATETIMEVALUE(
TEXT(YEAR({!$Flow.CurrentDate} + CASE(WEEKDAY({!$Flow.CurrentDate}), 5, 4, 6, 4, 7, 3, 2))) + &quot;-&quot; +
TEXT(MONTH({!$Flow.CurrentDate} + CASE(WEEKDAY({!$Flow.CurrentDate}), 5, 4, 6, 4, 7, 3, 2))) + &quot;-&quot; +
TEXT(DAY({!$Flow.CurrentDate} + CASE(WEEKDAY({!$Flow.CurrentDate}), 5, 4, 6, 4, 7, 3, 2))) + &quot; 17:00:00&quot;
)</expression>
    </formulas>
