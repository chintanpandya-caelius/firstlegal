    <formulas>
        <name>RelatedWhatId</name>
        <dataType>String</dataType>
        <expression>IF(OR(LEFT({!recordId}, 3) = &quot;001&quot;, LEFT({!recordId}, 3) = &quot;006&quot;), {!recordId}, NULL)</expression>
    </formulas>
    <formulas>
        <name>RelatedWhoId</name>
        <dataType>String</dataType>
        <expression>IF(OR(LEFT({!recordId}, 3) = &quot;003&quot;, LEFT({!recordId}, 3) = &quot;00Q&quot;), {!recordId}, NULL)</expression>
    </formulas>
    <formulas>
        <name>ValidContext</name>
        <dataType>Boolean</dataType>
        <expression>AND(OR(LEN({!recordId}) = 15, LEN({!recordId}) = 18), OR(LEFT({!recordId},3) = &quot;001&quot;, LEFT({!recordId},3) = &quot;003&quot;, LEFT({!recordId},3) = &quot;00Q&quot;, LEFT({!recordId},3) = &quot;006&quot;))</expression>
    </formulas>
