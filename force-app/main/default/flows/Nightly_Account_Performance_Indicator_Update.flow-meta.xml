    <decisions>
        <name>Check_if_Newly_Cold</name>
        <label>Check if Newly Cold</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Newly_Cold</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Account_Performance_Indicator__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Cold</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>formulaPerformanceIndicator</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Cold</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Cold_Review_Task</targetReference>
            </connector>
            <label>Newly Cold</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Opportunity_Status</name>
        <label>Check Opportunity Status</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Loop_Through_Opportunities</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Is_Open</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Through_Opportunities.IsClosed</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Has_Active_Opp</targetReference>
            </connector>
            <label>Is Open</label>
        </rules>
        <rules>
            <name>IsRecent</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Through_Opportunities.LastModifiedDate</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>formulaThirtyDaysAgo</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Has_Recent_Movement</targetReference>
            </connector>
            <label>IsRecent</label>
        </rules>
    </decisions>
    <decisions>
        <name>Determine_Opportunity_Activity</name>
        <label>Determine Opportunity Activity</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>NoActivity</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Activity</defaultConnectorLabel>
        <rules>
            <name>Active_Opportunity</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varHasActiveOpp</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Active_Opportunity_n</targetReference>
            </connector>
            <label>Active Opportunity</label>
        </rules>
        <rules>
            <name>Recent_Movement</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varHasRecentMovement</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varHasActiveOpp</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Recent_Movement_n</targetReference>
            </connector>
            <label>Recent Movement</label>
        </rules>
    </decisions>
    <description>Scheduled nightly flow that evaluates ABM target Accounts (ABM Target = True, ABM Target Status = Active) and calculates their Account Performance Indicator (Hot/Warm/Cold) based on Engagement Score, Revenue Potential Score, Opportunity Activity, and Last Interaction Date. Also derives Opportunity Activity Indicator from related Opportunities. Creates a review Task when an Account newly becomes Cold. Part of NOVA — Identify and Action Underperforming ABM Target Accounts.</description>
    <environments>Default</environments>
    <formulas>
        <name>ActivityDate</name>
        <dataType>Date</dataType>
        <expression>{!$Flow.CurrentDate} + 3</expression>
    </formulas>
    <formulas>
        <description>Engagement Points</description>
        <name>formulaEngagementPoints</name>
        <dataType>Number</dataType>
        <expression>IF({!$Record.Engagement_Score__c} &gt;= 70, 30,
IF({!$Record.Engagement_Score__c} &gt;= 35, 15, 0))</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>formulaLastInteractionPoints</name>
        <dataType>Number</dataType>
        <expression>IF(({!$Flow.CurrentDate} - DATEVALUE({!$Record.LastModifiedDate})) &lt;= 30, 15,
IF(({!$Flow.CurrentDate} - DATEVALUE({!$Record.LastModifiedDate})) &lt;= 90, 8, 0))</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>formulaOpportunityActivityPoints</name>
        <dataType>Number</dataType>
        <expression>IF(TEXT({!$Record.Opportunity_Activity_Indicator__c}) = &quot;Active Opportunity&quot;, 25,
IF(TEXT({!$Record.Opportunity_Activity_Indicator__c}) = &quot;Recent Movement&quot;, 15, 0))</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>formulaPerformanceIndicator</name>
        <dataType>String</dataType>
        <expression>IF({!formulaTotalPerformanceScore} &gt;= 70, &quot;Hot&quot;,
IF({!formulaTotalPerformanceScore} &gt;= 35, &quot;Warm&quot;, &quot;Cold&quot;))</expression>
    </formulas>
    <formulas>
        <description>Revenue Points</description>
        <name>formulaRevenuePoints</name>
        <dataType>Number</dataType>
        <expression>IF({!$Record.Revenue_Potential_Score__c} &gt;= 70, 30,
IF({!$Record.Revenue_Potential_Score__c} &gt;= 35, 15, 0))</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>formulaThirtyDaysAgo</name>
        <dataType>Date</dataType>
        <expression>TODAY() - 30</expression>
    </formulas>
    <formulas>
        <name>formulaTotalPerformanceScore</name>
        <dataType>Number</dataType>
        <expression>{!formulaEngagementPoints} + {!formulaRevenuePoints} + {!formulaOpportunityActivityPoints} + {!formulaLastInteractionPoints}</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>Nightly Account Performance Indicator Update {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Nightly Account Performance Indicator Update</label>
    <loops>
