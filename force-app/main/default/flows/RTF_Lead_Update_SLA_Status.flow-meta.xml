<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Check_SLA_Status</name>
        <label>Check SLA Status</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>WITH_IN</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>BREACHED</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>formula_Now</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <elementReference>$Record.SLA_Due_Date__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>BREACHED_PATH</targetReference>
            </connector>
            <label>BREACHED</label>
        </rules>
        <rules>
            <name>APPROACHING</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>formula_Now</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>formula_SLA_Approaching_Time</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>APPROACHING_PATH</targetReference>
            </connector>
            <label>APPROACHING</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>formula_Now</name>
        <dataType>DateTime</dataType>
        <expression>NOW()</expression>
    </formulas>
    <formulas>
        <name>formula_SLA_Approaching_Time</name>
        <dataType>DateTime</dataType>
        <expression>$Record.SLA_Due_Date__c - (4/24)</expression>
    </formulas>
    <interviewLabel>RTF | Lead | Update SLA Status {!$Flow.CurrentDateTime}</interviewLabel>
    <label>RTF | Lead | Update SLA Status</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>APPROACHING_PATH</name>
        <label>APPROACHING PATH</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>SLA_Status__c</field>
            <value>
                <stringValue>Approaching SLA</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>BREACHED_PATH</name>
        <label>BREACHED PATH</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>SLA_Status__c</field>
            <value>
                <stringValue>Breached SLA</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>WITH_IN</name>
        <label>WITH IN</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>SLA_Status__c</field>
            <value>
                <stringValue>Within SLA</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_SLA_Status</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>SLA_Due_Date__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Lead</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
