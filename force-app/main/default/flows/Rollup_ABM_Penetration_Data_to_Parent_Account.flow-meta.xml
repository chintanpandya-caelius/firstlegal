    <decisions>
        <name>Trend</name>
        <label>Trend</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Set_Trend_Default</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Growing</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_the_Previous_Snapshot.Penetration_Score_Snapshot__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_the_Previous_Snapshot.Penetration_Score_Snapshot__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <elementReference>formulaPenetrationScore</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Trend_Growing</targetReference>
            </connector>
            <label>Growing</label>
        </rules>
        <rules>
            <name>Declining</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>formulaPenetrationScore</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>formulaPenetrationScore</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Trend_Declining</targetReference>
            </connector>
            <label>Declining</label>
        </rules>
        <rules>
            <name>Stable</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>formulaPenetrationScore</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>formulaPenetrationScore</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Trend_Stable</targetReference>
            </connector>
            <label>Stable</label>
        </rules>
    </decisions>
    <description>Rolls up ABM contact and revenue totals from child accounts to the parent account whenever a child target account is updated, to support parent-level penetration reporting.</description>
    <environments>Default</environments>
    <formulas>
        <name>formulaPenetrationScore</name>
        <dataType>Number</dataType>
        <expression>(({!varTotalContacts} / {!Get_the_Parent_Account.ABM_Firm_Size__c}) * 100 * 0.5) + 
(CASE(TEXT({!Get_the_Parent_Account.ABM_Revenue_Benchmark_Tier__c}),
   &quot;Below Peer Average&quot;, 20,
   &quot;At Peer Average&quot;, 50,
   &quot;Above Peer Average&quot;, 80,
   &quot;Top Performer&quot;, 100,
   0) * 0.5)</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>Rollup ABM Penetration Data to Parent Account {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Rollup ABM Penetration Data to Parent Account</label>
    <loops>
