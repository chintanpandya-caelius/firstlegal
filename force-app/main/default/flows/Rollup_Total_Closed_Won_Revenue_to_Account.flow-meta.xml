        <locationY>0</locationY>
        <collectionReference>Closed_Won_Opportunities</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Add_Opportunity_Amount_to_Total</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
