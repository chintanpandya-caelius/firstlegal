    <decisions>
        <name>Check_Campaign_Member</name>
        <label>Check Campaign Member</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Lead</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>CheckCampaignMember</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Lead</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_MCLE_CLE_Task</targetReference>
            </connector>
            <label>Lead</label>
        </rules>
        <rules>
            <name>Contact</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>CheckCampaignMember</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Contact</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Copy_1_of_Create_MCLE_CLE_Task</targetReference>
            </connector>
            <label>Contact</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Campaign_Source</name>
        <label>Check Campaign Source</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>MCLE_CLE</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Campaign_Member_Source__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>MCLE Registration</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_Campaign_Member</targetReference>
            </connector>
            <label>MCLE/CLE</label>
        </rules>
        <rules>
            <name>Event_Attendee</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Campaign_Member_Source__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Event Registration</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Copy_1_of_Check_Campaign_Member</targetReference>
            </connector>
            <label>Event Attendee</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Status</name>
        <label>Check Status</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Not Attended</defaultConnectorLabel>
        <rules>
            <name>Attended</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Journey_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Attended</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Responded</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_Campaign_Source</targetReference>
            </connector>
            <label>Attended</label>
        </rules>
    </decisions>
    <decisions>
        <name>Copy_1_of_Check_Campaign_Member</name>
        <label>Check Campaign Member</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Copy_1_of_Lead</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>CheckCampaignMember</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Lead</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Event_Attendee_Task</targetReference>
            </connector>
            <label>Lead</label>
        </rules>
        <rules>
            <name>Copy_1_of_Contact</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>CheckCampaignMember</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Contact</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Copy_1_of_Create_Event_Attendee_Task</targetReference>
            </connector>
            <label>Contact</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>CheckCampaignMember</name>
        <dataType>String</dataType>
        <expression>IF(
    NOT(ISBLANK({!$Record.LeadId})),
    &quot;Lead&quot;,
    IF(
        NOT(ISBLANK({!$Record.ContactId})),
        &quot;Contact&quot;,
        &quot;Unknown&quot;
    )
)</expression>
    </formulas>
    <interviewLabel>Signals for different campaign types {!$Flow.CurrentDateTime}</interviewLabel>
