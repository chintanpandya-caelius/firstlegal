    </formulas>
    <formulas>
        <name>Seven_Days_After_Resolved</name>
        <dataType>Boolean</dataType>
        <expression>ISPICKVAL({!$Record.Status}, &quot;Resolved&quot;) &amp;&amp;
{!$Record.Resolved_Date__c} &lt;= TODAY() - 7</expression>
    </formulas>
