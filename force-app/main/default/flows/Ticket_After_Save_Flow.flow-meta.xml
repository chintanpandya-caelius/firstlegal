    <formulas>
        <name>IsEligibleForAckEmail</name>
        <dataType>Boolean</dataType>
        <expression>NOT(ISBLANK({!$Record.SuppliedEmail})) &amp;&amp;
NOT(CONTAINS(&quot;,&quot; &amp; $Label.Excluded_Ack_Emails &amp; &quot;,&quot;, &quot;,&quot; &amp; {!$Record.SuppliedEmail} &amp; &quot;,&quot;)) &amp;&amp;
NOT(CONTAINS({!$Record.SuppliedEmail}, &quot;firstlegal&quot;))</expression>
    </formulas>
    <formulas>
