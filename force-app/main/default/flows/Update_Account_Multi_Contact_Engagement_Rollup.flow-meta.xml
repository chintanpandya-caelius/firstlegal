    <decisions>
        <name>Determine_Multi_Contact_Engagement_Level</name>
        <label>Determine Multi-Contact Engagement Level</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Set_None_Engagement_Level</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>High_Multi_Contact_Engagement</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Engaged_Contact_Count</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>3.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_High_Multi_Contact_Engagement_Level</targetReference>
            </connector>
            <label>High Multi-Contact Engagement</label>
        </rules>
        <rules>
            <name>Multi_Contact_Engagement</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Engaged_Contact_Count</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>2.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Multi_Contact_Engagement_Level</targetReference>
            </connector>
            <label>Multi-Contact Engagement</label>
        </rules>
        <rules>
            <name>Single_Contact_Engagement</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Engaged_Contact_Count</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>1.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Single_Contact_Engagement_Level</targetReference>
            </connector>
            <label>Single Contact Engagement</label>
        </rules>
    </decisions>
