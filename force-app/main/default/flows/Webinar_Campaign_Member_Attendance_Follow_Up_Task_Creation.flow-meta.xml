            </connector>
            <label>Contact</label>
        </rules>
    </decisions>
    <decisions>
        <name>Status_Attended</name>
        <label>Status = Attended</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Attended</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Attended</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_Lead_or_Contact</targetReference>
            </connector>
            <label>Status = Attended</label>
        </rules>
        <rules>
            <name>Status_Did_Not_Attend</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Did Not Attend</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>NotAttended_Check_Lead_or_Contact</targetReference>
            </connector>
            <label>Status = Did Not Attend</label>
        </rules>
        <rules>
            <name>Status_Partially_Attended</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Partially Attended</stringValue>
                </rightValue>
            </conditions>
            <label>Status = Partially Attended</label>
        </rules>
    </decisions>
